{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "SqlServerDev": "Server=(localdb)\\MSSQLLocalDB;Database=ElectroParts;Trusted_Connection=True;Encrypt=False;"
  },
  "Identity": {
    "Password": {
      "RequireDigit": true,
      "RequireLowercase": false,
      "RequireUppercase": false,
      "RequireNonAlphanumeric": false,
      "RequiredUniqueChars": 1,
      "RequiredLength": 3
    },
    "SignIn": {
      "RequireConfirmedAccount": false
    },
    "User": {
      "RequireUniqueEmail": true
    }
  }
}
