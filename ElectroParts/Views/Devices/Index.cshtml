@model IEnumerable<ElectroParts.ViewModels.Device.DeviceListViewModel>

@{
    ViewData["Title"] = "Устройства";
}

<h1>Устройства</h1>

@if (User.Identity?.IsAuthenticated == true)
{
    <p>
        <a asp-controller="Devices"
           asp-action="Create"
           class="btn btn-primary">
            Добави устройство
        </a>
    </p>
}

@await Html.PartialAsync("_DevicesTablePartial", Model)

