@model ElectroParts.ViewModels.Device.DeviceDetailsViewModel

@{
    ViewData["Title"] = "Подробности за устройството";
}

<h1>Подробности за устройството</h1>

<div class="card">
    <div class="card-body">
        <h4 class="card-title">@Model.Name</h4>

        <dl class="row">
            <dt class="col-sm-3">Тип</dt>
            <dd class="col-sm-9">@Model.DeviceTypeName</dd>

            <dt class="col-sm-3">Модел</dt>
            <dd class="col-sm-9">@(Model.Model ?? "Няма данни")</dd>

            <dt class="col-sm-3">Производител</dt>
            <dd class="col-sm-9">@Model.ManufacturerName</dd>

            <dt class="col-sm-3">Описание</dt>
            <dd class="col-sm-9">@(Model.Description ?? "Няма описание")</dd>

            <dt class="col-sm-3">Добавено на</dt>
            <dd class="col-sm-9">@Model.CreatedOn.ToString("dd.MM.yyyy HH:mm")</dd>
        </dl>

        <h5>Свързани части</h5>

        @if (Model.Parts.Any())
        {
            <ul>
                @foreach (var part in Model.Parts)
                {
                    <li class="mb-2">
                        <a asp-controller="Parts"
                           asp-action="Details"
                           asp-route-id="@part.Id">
                            @part.Name
                        </a>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form asp-controller="Devices"
                                  asp-action="RemovePart"
                                  method="post"
                                  class="d-inline">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="partId" value="@part.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger ms-2">
                                    Премахни връзката
                                </button>
                            </form>
                        }
                    </li>
                }
            </ul>
        }
        else
        {
            <p>Няма въведени свързани части.</p>
        }
        
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="mb-3">
                <a asp-controller="Devices"
                   asp-action="AddPart"
                   asp-route-id="@Model.Id"
                   class="btn btn-success">
                    Добави част
                </a>
            </div>
        }


        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Devices"
               asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary me-2">
                Редактирай
            </a>
            <form asp-controller="Devices"
                  asp-action="Delete"
                  asp-route-id="@Model.Id"
                  method="get"
                  class="d-inline">
                <button type="submit" class="btn btn-danger me-2">
                    Изтрий
                </button>
            </form>
        }
        <a asp-controller="Devices"
           asp-action="Index"
           class="btn btn-secondary">
            Обратно към списъка
        </a>
    </div>
</div>
