@using ElectroParts.Services.DTOs.Manufacturer.Response
@using ElectroParts.Services.DTOs.PartType.Response
@using ElectroParts.Services.DTOs.Part.Request
@using Microsoft.AspNetCore.Mvc.Rendering
@model AddPartRequestData

@{
    ViewData["Title"] = "Добавяне на част";
}

<h1>Добавяне на част</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Име</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PartTypeId" class="form-label">Тип част</label>
                <select asp-for="PartTypeId"
                        class="form-select"
                        asp-items="@(new SelectList((IEnumerable<GetPartTypesResponseData>)ViewBag.PartTypes, nameof(GetPartTypesResponseData.Id), nameof(GetPartTypesResponseData.Name)))">
                    <option value="">-- Избери тип --</option>
                </select>
                <span asp-validation-for="PartTypeId" class="text-danger"></span>
            </div>
                        
            <div class="mb-3">
                <a asp-controller="PartTypes"
                   asp-action="Create"
                   target="_blank"
                   class="btn btn-outline-success btn-sm">
                    + Добави нов тип част
                </a>
            </div>

            <div class="mb-3">
                <label asp-for="ManufacturerId" class="form-label">Производител</label>
                <select asp-for="ManufacturerId"
                        class="form-select"
                        asp-items="@(new SelectList((IEnumerable<GetManufacturersResponseData>)ViewBag.Manufacturers, nameof(GetManufacturersResponseData.Id), nameof(GetManufacturersResponseData.Name)))">
                    <option value="">-- Избери производител --</option>
                </select>
                <span asp-validation-for="ManufacturerId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ShortDescription" class="form-label">Кратко описание</label>
                <textarea asp-for="ShortDescription" class="form-control"></textarea>
                <span asp-validation-for="ShortDescription" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Описание</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Запази</button>
            <a asp-action="Index" class="btn btn-secondary">Отказ</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

