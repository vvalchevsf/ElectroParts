@model IEnumerable<ElectroParts.ViewModels.Part.PartListViewModel>

@{
    ViewData["Title"] = "Части";
}

<h1>Каталог на частите</h1>


@if (User.Identity?.IsAuthenticated == true)
{
    <a asp-controller="Parts"
       asp-action="Create"
       class="btn btn-primary mb-3">
        Добави част
    </a>
}


<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Име</th>
            <th>Тип</th>
            <th>Производител</th>
            <th>Кратко описание</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var part in Model)
        {
            <tr>
                <td>
                    <a asp-controller="Parts"
                       asp-action="Details"
                       asp-route-id="@part.Id">
                        @part.Name
                    </a>
                </td>
                <td>@part.PartTypeName</td>
                <td>@part.ManufacturerName</td>
                <td>@(part.ShortDescription ?? "Няма данни")</td>
            </tr>
        }
    </tbody>
</table>
