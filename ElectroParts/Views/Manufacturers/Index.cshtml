@using ElectroParts.Services.DTOs.Manufacturer.Response
@model IEnumerable<GetManufacturersResponseData>

@{
    ViewData["Title"] = "Производители";
}

<h1>Производители</h1>

@if (User.Identity?.IsAuthenticated == true)
{
    <a asp-action="Create" class="btn btn-primary mb-3">
        Добави производител
    </a>
}

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Име</th>
            <th>Адрес</th>
            <th>Уебсайт</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var manufacturer in Model)
        {
            <tr>
                <td>@manufacturer.Name</td>
                <td>@manufacturer.Address</td>
                <td>
                    @if (!string.IsNullOrWhiteSpace(manufacturer.Url))
                    {
                        <a href="@manufacturer.Url"
                           target="_blank"
                           rel="noopener noreferrer">
                            Посети сайта
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
